# Local development placeholders. Copy to `.env` and fill locally. Never commit `.env`.
# No real secrets, passwords, patient data, or paid API keys belong here.

# PostgreSQL / PostGIS via Docker Compose (local only)
DATABASE_URL="postgresql://emergency:emergency@localhost:5432/emergency?schema=public"
DIRECT_URL="postgresql://emergency:emergency@localhost:5432/emergency?schema=public"

# Better Auth (dev placeholder — generate a real one per environment with: npx @better-auth/cli secret)
BETTER_AUTH_SECRET="dev-only-replace-me-32-chars-minimum-please"
BETTER_AUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Emergency Care"
NEXT_PUBLIC_PILOT_MARKET="unspecified"
# Mock integrations are ON for local dev (no real SMS/calls/dispatch/hospital traffic)
NEXT_PUBLIC_USE_MOCKS="true"
NEXT_PUBLIC_EMERGENCY_NUMBER="UNSPECIFIED-USE-MOCK"
