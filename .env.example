# Local development placeholders. Copy to `.env` and fill locally. Never commit `.env`.
# No real secrets, passwords, patient data, or paid API keys belong here.

# PostgreSQL / PostGIS via Docker Compose (local only)
DATABASE_URL="postgresql://emergency:emergency@localhost:5432/emergency?schema=public"
DIRECT_URL="postgresql://emergency:emergency@localhost:5432/emergency?schema=public"

# Better Auth (dev placeholder — generate a real one per environment with: npx @better-auth/cli secret)
BETTER_AUTH_SECRET="dev-only-replace-me-32-chars-minimum-please"
BETTER_AUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Emergency Care"
NEXT_PUBLIC_PILOT_MARKET="unspecified"
# Mock integrations are ON for local dev (no real SMS/calls/dispatch/hospital traffic)
NEXT_PUBLIC_USE_MOCKS="true"
NEXT_PUBLIC_EMERGENCY_NUMBER="UNSPECIFIED-USE-MOCK"
# Meta WhatsApp Cloud API (server-side only; never NEXT_PUBLIC_).
# Leave empty until a WhatsApp Business number, app credentials, and an
# approved message template exist. See README deployment notes.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_NAME="emergency_alert"
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Daily voice/video (server-side key only; the browser receives just a room URL
# plus a short-lived participant token). Leave empty until configured.
DAILY_API_KEY=""
# DAILY_API_BASE="https://api.daily.co/v1"
# Set DAILY_ENABLED="true" to enable only Daily calls during local development.
# This leaves the global demo mode on, so WhatsApp and other integrations stay inert.
DAILY_ENABLED="false"
# Demo kill-switch (server-side only, never NEXT_PUBLIC_). Demo mode stays
# ON unless explicitly disabled: WhatsApp and other providers stay inert.
# Daily can be enabled separately for local development with DAILY_ENABLED.
# Set DEMO_MODE="false" only for production operation with real partners.
# DEMO_MODE="true"
# Demo-mode doctor contact (server-side only, never NEXT_PUBLIC_).
# Leave empty until the demo controller provides a real international number.
# Example format when set: "+2348012345678" (digits with country code).
DOCTOR_WHATSAPP_NUMBER=""
